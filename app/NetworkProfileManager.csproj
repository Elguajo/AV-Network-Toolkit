<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>NetworkProfileManager</AssemblyName>
    <RootNamespace>NetworkProfileManager</RootNamespace>
    <AssemblyTitle>AV Network Toolkit</AssemblyTitle>
    <Product>AV Network Toolkit</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Versioning (overridable via /p:Version on CI) -->
    <Version>1.1.6</Version>
    <AssemblyVersion>1.1.6.0</AssemblyVersion>
    <FileVersion>1.1.6.0</FileVersion>
    <!-- The supported UI is English; skip unused dependency language resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">Preview</ReleaseChannel>
  </PropertyGroup>
  <!-- Publishing for a runtime, as the release zip does (self-contained win-x64), produces one
       .exe plus WPF's five native DLLs. They stay beside the exe on purpose: bundling them
       unpacks them to the user-writable %TEMP% folder, and the elevated netsh worker would
       then load DLLs any process of the user could replace. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetworkProfileManager.Tests" />
    <InternalsVisibleTo Include="ProjectUiSmoke" />
    <EmbeddedResource Include="..\schemas\project.avnet.schema.json" LogicalName="ProjectSchema.json" />
    <EmbeddedResource Include="..\schemas\project.avnet.v2.schema.json" LogicalName="ProjectSchemaV2.json" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
    <EmbeddedResource Include="$(UpdatePublicKeyFile)" LogicalName="ApplicationUpdatePublicKey.pem"
                      Condition="'$(UpdatePublicKeyFile)' != ''" />
    <None Include="..\docs\legal\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <UsingTask TaskName="ValidateUpdatePublicKey" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup><KeyFile ParameterType="System.String" Required="true" /></ParameterGroup>
    <Task><Using Namespace="System.IO" /><Code Type="Fragment" Language="cs"><![CDATA[
      var text = File.ReadAllText(KeyFile);
      if (text.Length > 8192 || !text.StartsWith("-----BEGIN PUBLIC KEY-----") || text.Contains("PRIVATE")) {
        Log.LogError("UpdatePublicKeyFile must contain only a public SubjectPublicKeyInfo PEM key. Never embed a private key.");
        return false;
      }
    ]]></Code></Task>
  </UsingTask>
  <Target Name="ValidateApplicationUpdateKey" BeforeTargets="PrepareForBuild" Condition="'$(UpdatePublicKeyFile)' != ''">
    <ValidateUpdatePublicKey KeyFile="$(UpdatePublicKeyFile)" />
  </Target>
</Project>
