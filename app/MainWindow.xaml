<ui:FluentWindow x:Class="NetworkProfileManager.MainWindow" x:Name="MainRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:NetworkProfileManager.ViewModels"
        xmlns:views="clr-namespace:NetworkProfileManager.Views"
        Title="{DynamicResource App.Title}"
        Icon="/NetworkProfileManager;component/Assets/icon.ico"
        Width="1200" Height="850"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
  <ui:FluentWindow.Resources>
   <Style x:Key="WorkspaceTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
    <Setter Property="Padding" Value="8,10"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Grid>
      <Border x:Name="Hover" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"/>
      <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
      <Border x:Name="SelectedLine" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedLine" Property="Visibility" Value="Visible"/><Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{DynamicResource App.Title}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/NetworkProfileManager;component/Assets/icon.ico" Width="16" Height="16"/>
      </ui:TitleBar.Icon>
      <ui:TitleBar.TrailingContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
          <ToggleButton x:Name="SidebarToggle" Style="{StaticResource SidebarToggle}"
                        IsChecked="{Binding IsSidebarExpanded, ElementName=MainRoot, Mode=TwoWay}">
            <ui:SymbolIcon Symbol="PanelLeft20" FontSize="20"/>
          </ToggleButton>
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <Grid x:Name="NavigationLayout" Grid.Row="1" SizeChanged="NavigationSizeChanged" UseLayoutRounding="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="RailColumn" Width="52"/>
        <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
        <ColumnDefinition x:Name="SplitterColumn" Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="NavigationRail" Grid.Column="0" BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              KeyboardNavigation.TabNavigation="Local"
              AutomationProperties.Name="{DynamicResource Navigation.Tools}">
        <Grid Margin="8,8,7,8">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="RailScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                        Focusable="False">
            <StackPanel>
              <RadioButton x:Name="RailAdapters" IsChecked="True" GroupName="MainLocation" Style="{StaticResource RailToggle}" Margin="0,0,0,8"
                           ToolTip="{DynamicResource Adapters.Header}" AutomationProperties.Name="{DynamicResource Adapters.Header}" Click="RevealAdaptersClick">
                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="20"/>
              </RadioButton>
              <ui:Button x:Name="RailProjects" Style="{StaticResource RailButton}"
                         ToolTip="{DynamicResource Project.Title}" AutomationProperties.Name="{DynamicResource Project.Title}" Click="OpenProjectClick">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Folder20" FontSize="20"/></ui:Button.Icon>
              </ui:Button>
              <Border Height="1" Margin="4,0,4,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
              <ui:Button x:Name="RailLinkLocal" Style="{StaticResource RailButton}"
                         ToolTip="{DynamicResource LinkLocal.Title}" AutomationProperties.Name="{DynamicResource LinkLocal.Title}" Click="OpenLinkLocalClick">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Link20" FontSize="20"/></ui:Button.Icon>
              </ui:Button>
              <ui:Button x:Name="RailScanner" Style="{StaticResource RailButton}"
                         ToolTip="{DynamicResource MainWindow.IpScannerTooltip}" AutomationProperties.Name="{DynamicResource MainWindow.IpScannerTooltip}" Click="OpenScannerClick">
                <ui:Button.Icon><ui:SymbolIcon Symbol="SearchInfo20" FontSize="20"/></ui:Button.Icon>
              </ui:Button>
              <ui:Button x:Name="RailMdns" Style="{StaticResource RailButton}"
                         ToolTip="{Binding IsMdnsListening, ElementName=MainRoot, Converter={StaticResource MdnsActivityText}}"
                         AutomationProperties.Name="{DynamicResource Mdns.Title}"
                         AutomationProperties.HelpText="{Binding IsMdnsListening, ElementName=MainRoot, Converter={StaticResource MdnsActivityText}}" Click="OpenMdnsClick">
                <ui:Button.Content>
                  <Grid Width="24" Height="24">
                    <ui:SymbolIcon Symbol="Globe20" FontSize="20"/>
                    <Border x:Name="MdnsActivityBadge" Style="{StaticResource RailActivityBadge}"
                            Visibility="{Binding IsMdnsListening, ElementName=MainRoot, Converter={StaticResource BoolToVis}}"/>
                  </Grid>
                </ui:Button.Content>
              </ui:Button>
              <ui:Button x:Name="RailTests" AutomationProperties.Name="{DynamicResource NetworkTests.Title}"
                         AutomationProperties.HelpText="{Binding AreTestsRunning, ElementName=MainRoot, Converter={StaticResource TestsActivityText}}" Click="OpenPingWindowClick">
                <ui:Button.Content>
                  <Grid Width="24" Height="24">
                    <ui:SymbolIcon Symbol="Pulse20" FontSize="20"/>
                    <Border x:Name="TestsActivityBadge" Style="{StaticResource RailActivityBadge}"
                            Visibility="{Binding AreTestsRunning, ElementName=MainRoot, Converter={StaticResource BoolToVis}}"/>
                  </Grid>
                </ui:Button.Content>
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource RailButton}">
                    <Setter Property="ToolTip" Value="{Binding AreTestsRunning, ElementName=MainRoot, Converter={StaticResource TestsActivityText}}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedAdapter}" Value="{x:Null}">
                      <Setter Property="IsEnabled" Value="False"/>
                      <Setter Property="ToolTip" Value="{DynamicResource Navigation.TestsUnavailable}"/>
                    </DataTrigger></Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>
            </StackPanel>
          </ScrollViewer>
          <ui:Button x:Name="RailSettings" Grid.Row="1" Style="{StaticResource RailButton}" Margin="0"
                     ToolTip="{DynamicResource MainWindow.SettingsTooltip}"
                     AutomationProperties.Name="{DynamicResource MainWindow.SettingsTooltip}" Click="OpenThemeClick">
            <ui:Button.Icon><ui:SymbolIcon Symbol="Settings20" FontSize="20"/></ui:Button.Icon>
          </ui:Button>
        </Grid>
      </Border>

      <!-- Adapters sit directly on Mica, like a navigation pane -->
      <views:AdapterListPanel x:Name="AdapterSidebar" Grid.Column="1">
        <views:AdapterListPanel.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </views:AdapterListPanel.Resources>
      </views:AdapterListPanel>
      <GridSplitter x:Name="AdapterSplitter" Grid.Column="2" Style="{StaticResource SidebarSplitter}"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="10" Cursor="SizeWE"
                    DragCompleted="SidebarResizeCompleted" KeyUp="SidebarResizeKeyUp"
                    ToolTip="{DynamicResource Navigation.ResizeSidebar}" AutomationProperties.Name="{DynamicResource Navigation.ResizeSidebar}"/>

      <!-- Selected adapter page: the content layer over Mica -->
      <Border x:Name="WorkspaceSurface" Grid.Column="3"
              Background="{DynamicResource LayerFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              CornerRadius="8,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="420">
           <StackPanel.Style><Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedAdapter}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
           </Style></StackPanel.Style>
           <TextBlock Text="{DynamicResource Ux.NoAdapter}" Style="{StaticResource SectionHeaderText}" TextWrapping="Wrap"/>
           <TextBlock Text="{DynamicResource Ux.NoAdapterHint}" TextWrapping="Wrap" Margin="0,8,0,16"/>
           <WrapPanel>
            <ui:Button x:Name="EmptyRefresh" Content="{DynamicResource Apply.Refresh}" Command="{Binding RefreshCommand}" Appearance="Primary" Margin="0,0,8,8"/>
            <ui:Button Content="{DynamicResource Ux.PrepareProject}" Click="OpenProjectClick" Margin="0,0,0,8"/>
           </WrapPanel>
          </StackPanel>

          <ScrollViewer x:Name="RightPanel" Grid.Row="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedAdapter}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="24,20,24,24">

              <!-- ── Adapter header: name, then its live settings as plain facts ── -->
              <TextBlock Text="{Binding SelectedAdapter.Name}" Style="{StaticResource PageTitleText}"/>
              <TextBlock Text="{Binding SelectedAdapter.Description}"
                         Style="{StaticResource CaptionText}" Margin="0,2,0,4"/>
              <TextBlock Margin="0,0,0,12">
               <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                <Setter Property="Text" Value="{DynamicResource Workspace.LinkDisconnected}"/>
                <Style.Triggers><DataTrigger Binding="{Binding SelectedAdapter.IsConnected}" Value="True">
                 <Setter Property="Text" Value="{DynamicResource Workspace.LinkConnected}"/>
                </DataTrigger></Style.Triggers>
               </Style></TextBlock.Style>
              </TextBlock>

              <WrapPanel Margin="0,0,0,8">
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource EditBar.Ip}" Style="{StaticResource FieldLabel}"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CurrentIpText" FontSize="14" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="{Binding SelectedAdapter.CurrentIp}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedAdapter.HasLinkLocalAddress}" Value="True">
                              <Setter Property="Text" Value="{Binding SelectedAdapter.CurrentIp}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <ui:Button Style="{StaticResource SubtleButton}" Padding="4" Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon Copy16}"
                               Tag="{Binding SelectedAdapter.CurrentIp}"
                               ToolTip="{DynamicResource Adapters.CopyIpTooltip}"
                               AutomationProperties.Name="{DynamicResource Adapters.CopyIpTooltip}"
                               Visibility="{Binding SelectedAdapter.IsConnected, Converter={StaticResource BoolToVis}}"
                               Click="CopyIp_Click"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource EditBar.Subnet}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding SelectedAdapter.CurrentSubnet}" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource EditBar.Gateway}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding SelectedAdapter.CurrentGateway}" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource Adapter.Dns}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding SelectedAdapter.CurrentDnsDisplay}" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,12">
                  <TextBlock Text="{DynamicResource Adapter.Mode}" Style="{StaticResource FieldLabel}"/>
                  <TextBlock Text="{Binding SelectedAdapter.CurrentModeDisplay}" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
              </WrapPanel>

              <Border x:Name="ProjectBar" Style="{StaticResource Card}" Padding="12,4" Margin="0,4,0,12" DataContext="{Binding Project, ElementName=MainRoot}">
               <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                 <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                 <ui:SymbolIcon Symbol="Folder20" Margin="0,0,12,0" FontSize="20"/>
                 <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" VerticalAlignment="Center">
                  <Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding FileName, Mode=OneWay}"/>
                  <InlineUIContainer><TextBlock Text=" *" ToolTip="{DynamicResource Project.UnsavedChanges}" AutomationProperties.Name="{DynamicResource Project.UnsavedChanges}"
                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"/></InlineUIContainer>
                 </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                 <ui:Button Content="{DynamicResource Workspace.OpenProject}" Icon="{ui:SymbolIcon FolderOpen20}" Command="{Binding OpenCommand}" Click="ProjectOpened_Click" Style="{StaticResource SubtleButton}" Padding="10,6"/>
                 <ui:Button x:Name="SaveProject" Content="{DynamicResource Workspace.SaveProject}" Icon="{ui:SymbolIcon Save20}" Command="{Binding SaveCommand}" Style="{StaticResource SubtleButton}" Padding="10,6"/>
                 <ui:Button x:Name="ProjectMore" Icon="{ui:SymbolIcon MoreHorizontal20}" Style="{StaticResource SubtleButton}" Padding="6" Click="ProjectMore_Click"
                   ToolTip="{DynamicResource Workspace.MoreProject}" AutomationProperties.Name="{DynamicResource Workspace.MoreProject}">
                  <ui:Button.ContextMenu><ContextMenu>
                   <MenuItem Header="{DynamicResource Project.SaveAs}" Command="{Binding SaveAsCommand}"/>
                   <MenuItem Header="{DynamicResource Workspace.ManageProject}" Click="OpenProjectClick"/>
                  </ContextMenu></ui:Button.ContextMenu>
                 </ui:Button>
                </StackPanel>
               </Grid>
              </Border>
              <TabControl x:Name="WorkspaceTabs" ItemContainerStyle="{StaticResource WorkspaceTabItem}" AutomationProperties.Name="{DynamicResource Project.Sections}">
               <TabItem Header="{DynamicResource Workspace.NetworkProfiles}">
                <StackPanel>
                 <TabControl x:Name="ProfileScopes" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Workspace.ProfileSource}">
                  <TabControl.Template><ControlTemplate TargetType="TabControl">
                   <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                  </ControlTemplate></TabControl.Template>
                  <TabItem Header="{DynamicResource Workspace.AdapterProfiles}"><views:ProfilePanel/></TabItem>
                  <TabItem Header="{DynamicResource Workspace.ProjectProfiles}">
                   <views:ProjectProfilesPanel x:Name="ProjectProfiles" DataContext="{Binding Project, ElementName=MainRoot}"
                     TargetName="{Binding DataContext.SelectedAdapter.Name, ElementName=MainRoot}"
                     TargetLabel="{Binding DataContext.ApplyTargetLabel, ElementName=MainRoot}"/>
                  </TabItem>
                 </TabControl>
                 <TextBlock Text="{DynamicResource Workspace.ApplyHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,8"/>
                 <Expander Header="{DynamicResource Workspace.Manual}" Margin="0,8,0,0" Expanded="ToolExpanded">
                  <Border Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>
              <!-- One click fills the fields; it never applies on its own -->
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource EditBar.Presets}"
                           Style="{StaticResource FieldLabel}"
                           ToolTip="{DynamicResource EditBar.PresetsTooltip}"/>
                <ItemsControl ItemsSource="{Binding VendorPresets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ui:Button Content="{Binding Name}" ToolTip="{Binding Description}"
                                 FontSize="13" Padding="10,4" Margin="0,0,6,4"
                                 Command="{Binding DataContext.ApplyPresetCommand,
                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="{DynamicResource EditBar.Dhcp}"
                             IsChecked="{Binding SelectedAdapter.EditIsDhcp, FallbackValue=False}"
                             Margin="0,0,24,0"/>
                <RadioButton Content="{DynamicResource EditBar.Static}"
                             IsChecked="{Binding SelectedAdapter.EditIsStatic, FallbackValue=True}"/>
              </StackPanel>

              <Grid>
                <Grid.Resources>
                  <!-- Address fields only apply to a static setup; Apply shares the
                       grid but must stay enabled, since it also applies DHCP. -->
                  <Style x:Key="StaticOnlyField" TargetType="StackPanel">
                    <Setter Property="IsEnabled" Value="{Binding SelectedAdapter.EditIsStatic, FallbackValue=False}"/>
                  </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.Ip}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditIp, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              AutomationProperties.Name="{DynamicResource EditBar.Ip}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.Subnet}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditSubnet, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              AutomationProperties.Name="{DynamicResource EditBar.Subnet}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.Gateway}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditGateway, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              AutomationProperties.Name="{DynamicResource EditBar.Gateway}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.PrimaryDns}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditPrimaryDns, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{DynamicResource EditBar.PrimaryDns}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource StaticOnlyField}">
                  <TextBlock Text="{DynamicResource EditBar.SecondaryDns}" Style="{StaticResource FieldLabel}"/>
                  <ui:TextBox Text="{Binding SelectedAdapter.EditSecondaryDns, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{DynamicResource EditBar.SecondaryDns}"/>
                </StackPanel>

                <!-- Apply takes the free slot next to the DNS fields -->
                <ui:Button Grid.Row="2" Grid.Column="4"
                           Content="{Binding ApplyTargetLabel}"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                           Command="{Binding ApplyCommand}"/>
              </Grid>
            </StackPanel>
                  </Border>
                 </Expander>
                 <Expander Header="{Binding Diagnostics.SectionTitle}" Margin="0,8,0,0" Expanded="ToolExpanded">
                  <Border Style="{StaticResource Card}"><StackPanel>
                   <ui:Button Content="{DynamicResource NetworkTests.OpenWindow}" Click="OpenPingWindowClick"
                    Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                   <views:AdapterDiagnosticsPanel DataContext="{Binding Diagnostics}"/>
                  </StackPanel></Border>
                 </Expander>
                 <Expander Header="{DynamicResource Workspace.History}" Margin="0,8,0,0" Expanded="ToolExpanded">
                  <StackPanel>
                   <ui:Button Content="{DynamicResource Apply.Recovery}" Click="Recovery_Click" HorizontalAlignment="Left" Margin="0,8"/>
                   <views:HistoryPanel/>
                  </StackPanel>
                 </Expander>
                </StackPanel>
               </TabItem>
               <TabItem>
                <TabItem.Header><TextBlock Text="{Binding Project.Devices.Count, ElementName=MainRoot, StringFormat={StaticResource Workspace.DeviceTab}}"/></TabItem.Header>
                <Grid x:Name="DeviceWorkspace" DataContext="{Binding Project, ElementName=MainRoot}" Height="560"
                      MaxHeight="{Binding ViewportHeight, ElementName=RightPanel}" Margin="0,12,0,0">
                 <views:DeviceDirectoryView/>
                </Grid>
               </TabItem>
              </TabControl>
            </StackPanel>
          </ScrollViewer>
          <Border x:Name="WorkspaceFeedback" Grid.Row="1" Style="{StaticResource FooterBar}"
                  DataContext="{Binding Project, ElementName=MainRoot}" Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
           <Border.Resources>
            <Style x:Key="FeedbackText" TargetType="TextBlock">
             <Setter Property="TextWrapping" Value="Wrap"/>
             <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style>
           </Border.Resources>
           <StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource FeedbackText}" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock Text="{Binding DeviceNotice}" Style="{StaticResource FeedbackText}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding FileFeedback}" Style="{StaticResource FeedbackText}" AutomationProperties.LiveSetting="Polite"/>
           </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Busy overlay: blocks input while netsh runs (and UAC may be up) -->
    <Grid Grid.Row="1"
          Background="{DynamicResource SmokeFillColorDefaultBrush}"
          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <Border Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
              BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
              BorderThickness="1" CornerRadius="8" Padding="24,16"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" Margin="0,0,12,0"/>
          <TextBlock Text="{DynamicResource MainWindow.BusyApplying}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <ui:SnackbarPresenter x:Name="RootSnackbar"
                          Grid.Row="0" Grid.RowSpan="2"
                          VerticalAlignment="Bottom"
                          Margin="16,0,16,12"/>

    <ui:ContentDialogHost x:Name="RootDialogHost"
                          Grid.Row="0" Grid.RowSpan="2"/>
  </Grid>
</ui:FluentWindow>
