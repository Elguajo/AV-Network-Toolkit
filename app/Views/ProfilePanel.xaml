<UserControl x:Class="NetworkProfileManager.Views.ProfilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <StackPanel>
    <DockPanel Margin="0,12,0,4" KeyboardNavigation.TabNavigation="Local">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ui:Button Style="{StaticResource SubtleButton}" Padding="6"
                   Icon="{ui:SymbolIcon ArrowImport20}"
                   Content="{DynamicResource Workspace.Import}"
                   KeyboardNavigation.TabIndex="1"
                   Command="{Binding ImportProfilesCommand}"
                   ToolTip="{DynamicResource Profiles.ImportTooltip}"
                   AutomationProperties.Name="{DynamicResource Profiles.ImportTooltip}"/>
        <ui:Button Style="{StaticResource SubtleButton}" Padding="6" Margin="2,0,8,0"
                   Icon="{ui:SymbolIcon ArrowExportLtr20}"
                   Content="{DynamicResource Workspace.Export}"
                   KeyboardNavigation.TabIndex="2"
                   Command="{Binding ExportProfilesCommand}"
                   ToolTip="{DynamicResource Profiles.ExportTooltip}"
                   AutomationProperties.Name="{DynamicResource Profiles.ExportTooltip}"/>
        <ui:Button Icon="{ui:SymbolIcon Add20}"
                   Appearance="Primary"
                   KeyboardNavigation.TabIndex="3"
                   Content="{DynamicResource Profiles.AddButton}"
                   Click="AddProfile_Click">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedAdapter.Profiles.Count}" Value="5">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedAdapter}" Value="{x:Null}">
                  <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>
      </StackPanel>
      <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
       <TextBlock Text="{Binding SelectedAdapter.Name, StringFormat={StaticResource Workspace.SavedFor}}" Style="{StaticResource SectionHeaderText}" TextWrapping="Wrap" Margin="0,0,12,4"/>
       <ComboBox SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=TabControl}, Mode=TwoWay}" MaxWidth="154" Margin="0,0,0,4" KeyboardNavigation.TabIndex="0"
                 ToolTip="{DynamicResource Ux.LocalScopeHint}" AutomationProperties.Name="{DynamicResource Workspace.ProfileSource}">
        <ComboBoxItem Content="{DynamicResource Workspace.LocalSource}"/>
        <ComboBoxItem Content="{DynamicResource Workspace.ProjectProfiles}"/>
       </ComboBox>
      </WrapPanel>
    </DockPanel>
    <TextBlock Text="{DynamicResource Workspace.LocalProfileHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

    <!-- Empty state -->
    <Border Padding="16">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedAdapter.Profiles.Count}" Value="0">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{DynamicResource Profiles.NoProfiles}"
                 Style="{StaticResource CaptionText}" FontSize="14" TextWrapping="Wrap"/>
    </Border>

    <ItemsControl ItemsSource="{Binding SelectedAdapter.Profiles}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,4" Padding="16,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Active profile: a check before the name, as in the tray menu.
                   Hidden (not collapsed) on the others so names stay aligned.
                   Apply stays available: the adapter may differ in ways the check can't see. -->
              <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                      Background="Transparent"
                      ToolTip="{DynamicResource Profiles.Active}"
                      AutomationProperties.Name="{DynamicResource Profiles.Active}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Hidden"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <ui:SymbolIcon Symbol="CheckmarkCircle20" Filled="True" FontSize="18"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
              </StackPanel>

              <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                         Style="{StaticResource CaptionText}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                         Text="{Binding ShortcutLabel}"/>

              <ui:Button Grid.Column="3" HorizontalAlignment="Stretch"
                         MaxWidth="200"
                         Content="{Binding DataContext.ApplyTargetLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Command="{Binding DataContext.ApplyProfileCommand,
                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         CommandParameter="{Binding}">
                <ui:Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="176"/></DataTemplate></ui:Button.ContentTemplate>
              </ui:Button>

              <ui:Button Grid.Column="4" Style="{StaticResource SubtleButton}" Padding="6" Margin="4,0,0,0"
                         Icon="{ui:SymbolIcon MoreHorizontal20}"
                         ToolTip="{DynamicResource Profiles.More}"
                         AutomationProperties.Name="{DynamicResource Profiles.More}"
                         Click="More_Click">
                <ui:Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{DynamicResource Common.Edit}" Tag="{Binding}" Click="EditProfile_Click">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Edit20"/>
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Common.Delete}" Tag="{Binding}" Click="DeleteProfile_Click">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Delete20"/>
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </ui:Button.ContextMenu>
              </ui:Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
