<ui:FluentWindow x:Class="NetworkProfileManager.Views.ProjectDeviceDialog" x:Name="DeviceDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:views="clr-namespace:NetworkProfileManager.Views"
 Title="{Binding EditorTitle, ElementName=DeviceDialog}" Width="620" Height="760" MinWidth="440" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="{Binding EditorTitle, ElementName=DeviceDialog}" ShowMinimize="False"/>
  <ScrollViewer x:Name="EditorViewport" Grid.Row="1" Margin="20,12,20,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="{Binding EditorTitle, ElementName=DeviceDialog}" Style="{StaticResource PageTitleText}"/>
    <TextBlock Text="{DynamicResource Device.FormHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,16"/>
    <TextBlock Text="{DynamicResource Device.RequiredName}" Style="{StaticResource FieldLabel}"/>
    <ui:TextBox x:Name="DeviceNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.RequiredName}"/>
    <TextBlock Text="{DynamicResource Device.RequiredUrl}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
    <ui:TextBox x:Name="DeviceUrlInput" Text="{Binding WebUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.RequiredUrl}" AutomationProperties.HelpText="{DynamicResource Device.UrlHint}"/>
    <TextBlock Text="{DynamicResource Device.UrlHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,16"/>
    <Expander x:Name="NetworkSection" AutomationProperties.Name="{DynamicResource Device.NetworkOptional}">
     <Expander.Header><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="Link20" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Device.NetworkOptional}"/>
       <TextBlock Text="{DynamicResource Device.NetworkSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
     </Grid></Expander.Header>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{DynamicResource Device.NetworkHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <ComboBox ItemsSource="{Binding Project.DeviceProfiles, ElementName=DeviceDialog}" SelectedValuePath="Id" SelectedValue="{Binding ProfileId}"
        DisplayMemberPath="Name" AutomationProperties.Name="{DynamicResource Device.Profile}"/>
       <ui:Button Content="{DynamicResource Device.Unlink}" Click="Unlink_Click" Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </Expander>
    <Expander x:Name="PasswordSection" Margin="0,12,0,0" Collapsed="Password_Collapsed" AutomationProperties.Name="{DynamicResource Device.PasswordOptional}">
     <Expander.Header><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="LockClosed20" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Device.PasswordOptional}"/>
       <TextBlock Text="{DynamicResource Device.PasswordHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
     </Grid></Expander.Header>
     <Border Style="{StaticResource Card}"><views:DevicePasswordFields x:Name="PasswordFields"/></Border>
    </Expander>
    <Expander x:Name="DetailsSection" Margin="0,12,0,0" AutomationProperties.Name="{DynamicResource Device.DetailsOptional}">
     <Expander.Header><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ui:SymbolIcon Symbol="Info20" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Device.DetailsOptional}"/>
       <TextBlock Text="{DynamicResource Device.DetailsHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel>
     </Grid></Expander.Header>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="{DynamicResource Device.Type}" Style="{StaticResource FieldLabel}"/>
       <ui:TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Type}"/>
       <TextBlock Text="{DynamicResource Device.Manufacturer}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
       <ui:TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Manufacturer}"/>
       <TextBlock Text="{DynamicResource Device.Ip}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
       <ui:TextBox x:Name="DeviceIpInput" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Ip}"/>
       <TextBlock Text="{DynamicResource Device.Notes}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
       <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="{DynamicResource Device.Notes}"/>
      </StackPanel>
     </Border>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Style="{StaticResource FooterBar}">
   <StackPanel>
    <TextBlock x:Name="EditorError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    <TextBlock Text="{DynamicResource Device.SaveHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <WrapPanel HorizontalAlignment="Right">
     <ui:Button Content="{DynamicResource Common.Cancel}" Click="Cancel_Click" IsCancel="True" MinWidth="96" Margin="0,0,8,0"/>
     <ui:Button x:Name="KeepButton" Content="{Binding KeepCaption, ElementName=DeviceDialog}" Appearance="Primary" Click="Keep_Click" IsDefault="True" MinWidth="96"/>
    </WrapPanel>
   </StackPanel>
  </Border>
 </Grid>
</ui:FluentWindow>
