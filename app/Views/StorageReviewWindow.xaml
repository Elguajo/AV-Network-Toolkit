<ui:FluentWindow x:Class="NetworkProfileManager.Views.StorageReviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Width="640" Height="480" MinWidth="480" MinHeight="340"
 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar x:Name="DialogTitle" ShowMinimize="False" ShowMaximize="False"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
   <StackPanel>
    <TextBlock x:Name="Heading" Style="{StaticResource SectionHeaderText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <Border Style="{StaticResource Card}"><TextBlock x:Name="ReviewText" TextWrapping="Wrap"/></Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Style="{StaticResource FooterBar}">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <ui:Button x:Name="AcceptButton" MinWidth="96" Margin="0,0,8,0" Appearance="Primary" Click="Accept_Click"/>
    <ui:Button x:Name="ExitButton" MinWidth="96" IsCancel="True" Click="Exit_Click"/>
   </StackPanel>
  </Border>
 </Grid>
</ui:FluentWindow>
