<ui:FluentWindow x:Class="NetworkProfileManager.Views.ProjectProfileDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:views="clr-namespace:NetworkProfileManager.Views"
 Title="{DynamicResource Workspace.ProfileEditor}" Width="520" Height="700" MinWidth="420" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="{DynamicResource Workspace.ProfileEditor}" ShowMinimize="False"/>
  <ScrollViewer Grid.Row="1" Margin="20,12,20,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="{DynamicResource Workspace.EditorHint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <views:ProjectProfileFields/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Style="{StaticResource FooterBar}">
   <StackPanel>
    <TextBlock x:Name="EditorError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <ui:Button Content="{DynamicResource Common.Cancel}" Click="Cancel_Click" MinWidth="96" Margin="0,0,8,0"/>
     <ui:Button Content="{DynamicResource Project.KeepProfile}" Appearance="Primary" Click="Keep_Click" MinWidth="96"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</ui:FluentWindow>
