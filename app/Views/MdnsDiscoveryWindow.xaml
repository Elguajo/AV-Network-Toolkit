<ui:FluentWindow x:Class="NetworkProfileManager.Views.MdnsDiscoveryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Mdns.Title}" Width="820" Height="760" MinWidth="620" MinHeight="540"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ui:TitleBar Title="{DynamicResource Mdns.Title}" ShowMinimize="False"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,12,20,16">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{DynamicResource Mdns.Disclaimer}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="{DynamicResource Mdns.Interface}" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" IsEnabled="{Binding CanSelect}"
                  AutomationProperties.Name="{DynamicResource Mdns.Interface}">
          <ComboBox.ItemTemplate><DataTemplate>
            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
          </DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ui:Button Content="{DynamicResource Mdns.Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource SubtleButton}"
                   Padding="10,6" HorizontalAlignment="Left" Margin="0,8,0,12"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="{Binding Counters}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{DynamicResource Mdns.Filter}" Style="{StaticResource FieldLabel}"/>
        <ui:TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="{DynamicResource Mdns.Filter}"/>
        <TextBlock Text="{DynamicResource Mdns.Results}" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,8"/>
        <ListBox ItemsSource="{Binding Rows}" Height="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                 AutomationProperties.Name="{DynamicResource Mdns.Results}" ItemContainerStyle="{StaticResource NavigationListItem}">
          <ListBox.ItemTemplate><DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Service.Instance}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Service.Instance}"/>
              <TextBlock Text="{Binding Service.ServiceType}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
              <TextBlock Text="{Binding State}" Margin="0,4,0,4"/>
              <WrapPanel>
                <TextBlock Text="{DynamicResource Mdns.Host}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Service.Hostname}" TextWrapping="Wrap"/>
              </WrapPanel>
              <TextBlock Text="{Binding Service.Addresses}" TextWrapping="Wrap"/>
              <WrapPanel>
                <TextBlock Text="{DynamicResource Mdns.Port}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Service.Port}" Margin="0,0,16,0"/>
                <TextBlock Text="{DynamicResource Mdns.Ttl}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Service.Ttl}"/>
              </WrapPanel>
            </StackPanel>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{DynamicResource Mdns.ExportWarning}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" TextTrimming="None" Margin="0,12,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource FooterBar}">
      <StackPanel>
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"
                 Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding Scope}" Style="{StaticResource CaptionText}" ToolTip="{Binding Scope}" Margin="0,0,0,8"/>
      <WrapPanel HorizontalAlignment="Right">
        <ui:Button Content="{DynamicResource Mdns.Export}" Command="{Binding ExportCommand}" MinWidth="96" Margin="0,0,8,8"/>
        <ui:Button Content="{DynamicResource Mdns.Start}" Command="{Binding StartCommand}" Appearance="Primary" MinWidth="96" Margin="0,0,8,8"/>
        <ui:Button Content="{DynamicResource Mdns.Stop}" Command="{Binding StopCommand}" MinWidth="96" Margin="0,0,8,8"/>
        <ui:Button Content="{DynamicResource Common.Close}" Click="Close_Click" MinWidth="96" Margin="0,0,0,8"/>
      </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
