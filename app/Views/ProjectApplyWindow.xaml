<ui:FluentWindow x:Class="NetworkProfileManager.Views.ProjectApplyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding WindowTitle}" Width="760" Height="760" MinWidth="620" MinHeight="520"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ui:TitleBar Title="{Binding WindowTitle}" ShowMinimize="False"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,12,20,16">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{DynamicResource Apply.Disclaimer}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Visibility="{Binding IsProjectAction, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding ProjectName}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
          <TextBlock Text="{Binding DeviceName}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None"/>
          <TextBlock Text="{Binding ProfileName}" Style="{StaticResource SectionHeaderText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource Apply.Adapter}" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" IsEnabled="{Binding CanSelectAdapter}"
                  AutomationProperties.Name="{DynamicResource Apply.Adapter}">
          <ComboBox.ItemTemplate><DataTemplate><StackPanel>
            <TextBlock Text="{Binding Alias}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Id}" Style="{StaticResource CaptionText}"/>
          </StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Visibility="{Binding IsLinkLocalTool, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
          <TextBlock Text="{DynamicResource LinkLocal.Instructions}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBlock Text="{DynamicResource LinkLocal.Address}" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding LinkLocalAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                      AutomationProperties.Name="{DynamicResource LinkLocal.Address}" MaxLength="15"/>
          <TextBlock Text="{DynamicResource LinkLocal.DnsInstructions}" TextWrapping="Wrap" Margin="0,12,0,8"/>
          <TextBlock Text="{DynamicResource EditBar.PrimaryDns}" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding LinkLocalDns1, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                      AutomationProperties.Name="{DynamicResource EditBar.PrimaryDns}" MaxLength="15"/>
          <TextBlock Text="{DynamicResource EditBar.SecondaryDns}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ui:TextBox Text="{Binding LinkLocalDns2, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                      AutomationProperties.Name="{DynamicResource EditBar.SecondaryDns}" MaxLength="15"/>
          <WrapPanel Margin="0,8,0,0">
            <ui:Button Content="{DynamicResource LinkLocal.Generate}" Command="{Binding GenerateAddressCommand}"
                       Style="{StaticResource SubtleButton}" Padding="10,6" Margin="0,0,8,8"/>
            <ui:Button Content="{DynamicResource LinkLocal.ReturnDhcp}" Command="{Binding ReviewDhcpCommand}" Margin="0,0,0,8"/>
          </WrapPanel>
        </StackPanel>
        <WrapPanel Margin="0,8,0,12">
          <ui:Button Content="{DynamicResource Apply.Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource SubtleButton}" Padding="10,6" Margin="0,0,8,8"/>
          <ui:Button Content="{DynamicResource Apply.Review}" Command="{Binding ReviewCommand}" Margin="0,0,0,8"/>
        </WrapPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <TextBlock Text="{Binding Review}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource Apply.RequestReview}"/>
        </Border>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,12"/>
        <TextBlock Text="{DynamicResource Apply.Observed}" Style="{StaticResource SectionHeaderText}"/>
        <TextBlock Text="{Binding Observed}" TextWrapping="Wrap" Margin="0,4,0,16"/>
        <TextBlock Text="{DynamicResource Apply.Recovery}" Style="{StaticResource SectionHeaderText}"/>
        <TextBlock Text="{DynamicResource Apply.ManualRecovery}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" TextTrimming="None" Margin="0,4,0,8"/>
        <ui:Button Content="{DynamicResource Apply.ReadSnapshots}" Command="{Binding ReadSnapshotsCommand}" Style="{StaticResource SubtleButton}" Padding="10,6" HorizontalAlignment="Left"/>
        <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" IsEnabled="{Binding CanSelect}" Margin="0,8,0,8"
                  AutomationProperties.Name="{DynamicResource Apply.Recovery}">
          <ComboBox.ItemTemplate><DataTemplate><StackPanel>
            <TextBlock Text="{Binding Before.Identity.Alias}"/>
            <TextBlock Text="{Binding OperationId}" Style="{StaticResource CaptionText}"/>
          </StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ui:Button Content="{DynamicResource Apply.ReviewRecovery}" Command="{Binding ReviewRecoveryCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource FooterBar}">
      <WrapPanel HorizontalAlignment="Right">
        <ui:Button Content="{DynamicResource Apply.Cancel}" Command="{Binding CancelCommand}" MinWidth="96" Margin="0,0,8,8"/>
        <ui:Button Content="{DynamicResource Apply.Confirm}" Command="{Binding ApplyCommand}" Appearance="Primary" MinWidth="96" Margin="0,0,8,8"/>
        <ui:Button Content="{DynamicResource Common.Close}" Click="Close_Click" MinWidth="96" Margin="0,0,0,8"/>
      </WrapPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
