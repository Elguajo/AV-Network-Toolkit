<UserControl x:Class="NetworkProfileManager.Views.ProjectProfileFields"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <StackPanel>
          <TextBlock Text="{Binding Id}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource AddProfile.NameLabel}" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
          <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource AddProfile.NameLabel}"/>
          <TextBlock Text="{DynamicResource Adapter.Mode}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ComboBox SelectedValue="{Binding Mode}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Adapter.Mode}">
            <ComboBoxItem Tag="dhcp" Content="{DynamicResource EditBar.Dhcp}"/>
            <ComboBoxItem Tag="static" Content="{DynamicResource EditBar.Static}"/>
          </ComboBox>
          <TextBlock Text="{DynamicResource Project.AdapterHint}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ui:TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Project.AdapterHint}"/>
          <StackPanel IsEnabled="{Binding IsStatic}">
            <TextBlock Text="{DynamicResource EditBar.Ip}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ui:TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource EditBar.Ip}"/>
            <TextBlock Text="{DynamicResource Project.Prefix}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ui:TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Project.Prefix}"/>
            <TextBlock Text="{DynamicResource Project.Gateway}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ui:TextBox Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Project.Gateway}"/>
            <TextBlock Text="{DynamicResource Project.DnsMode}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ComboBox SelectedValue="{Binding DnsMode}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Project.DnsMode}">
              <ComboBoxItem Tag="leave-unchanged" Content="{DynamicResource Project.DnsUnchanged}"/>
              <ComboBoxItem Tag="automatic" Content="{DynamicResource Project.DnsAutomatic}"/>
              <ComboBoxItem Tag="static" Content="{DynamicResource EditBar.Static}"/>
            </ComboBox>
            <StackPanel IsEnabled="{Binding IsDnsStatic}">
              <TextBlock Text="{DynamicResource EditBar.PrimaryDns}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
              <ui:TextBox Text="{Binding Dns1, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource EditBar.PrimaryDns}"/>
              <TextBlock Text="{DynamicResource AddProfile.SecondaryDnsLabel}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
              <ui:TextBox Text="{Binding Dns2, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource AddProfile.SecondaryDnsLabel}"/>
            </StackPanel>
          </StackPanel>
 </StackPanel>
</UserControl>
