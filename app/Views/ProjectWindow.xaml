<ui:FluentWindow x:Class="NetworkProfileManager.Views.ProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:NetworkProfileManager.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Project.Title}" Width="900" Height="780" MinWidth="700" MinHeight="540"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{DynamicResource Project.Title}" ShowMinimize="False"/>
    <WrapPanel Grid.Row="1" Margin="20,8">
      <ui:Button Style="{StaticResource SubtleButton}" Padding="10,6" Content="{DynamicResource Project.New}" Command="{Binding NewCommand}" Margin="0,0,8,8"/>
      <ui:Button Style="{StaticResource SubtleButton}" Padding="10,6" Content="{DynamicResource Project.Open}" Command="{Binding OpenCommand}" Margin="0,0,8,8"/>
      <ui:Button Style="{StaticResource SubtleButton}" Padding="10,6" Content="{DynamicResource Project.ChooseFolder}" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,8"/>
      <ui:Button Content="{DynamicResource Project.SaveAs}" Command="{Binding SaveAsCommand}" Appearance="Primary" MinWidth="96" Margin="0,0,0,8"/>
      <ui:Button Content="{DynamicResource Apply.Recovery}" Click="Recovery_Click" Style="{StaticResource SubtleButton}" Padding="10,6" Margin="8,0,0,8"/>
    </WrapPanel>
    <StackPanel Grid.Row="2" Margin="20,0,20,12">
      <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource Project.Path}"/>
      <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" AutomationProperties.Name="{DynamicResource Project.ChooseFolder}"/>
      <TextBlock Text="{DynamicResource Project.StorageOnly}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
      <TextBlock Text="{DynamicResource Project.UnsavedChanges}" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0"/>
    </StackPanel>
    <TabControl Grid.Row="3" Margin="20,0,20,12" SelectedIndex="{Binding Section}" AutomationProperties.Name="{DynamicResource Project.Sections}">
      <TabItem Header="{DynamicResource Profiles.Header}">
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Profiles.Header}" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                 ItemContainerStyle="{StaticResource NavigationListItem}" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{DynamicResource Profiles.Header}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" ToolTip="{Binding Id}" FontSize="14" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="1" VerticalAlignment="Top">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{DynamicResource Profiles.NoProfiles}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
        </Border>
        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
          <ui:Button Icon="{ui:SymbolIcon Add20}" Content="{DynamicResource Project.AddProfile}" Command="{Binding NewProfileCommand}" Margin="0,0,8,8"/>
          <ui:Button Style="{StaticResource SubtleButton}" Padding="10,6" Content="{DynamicResource Project.Delete}" Command="{Binding DeleteProfileCommand}" Margin="0,0,0,8"/>
        </WrapPanel>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{DynamicResource Project.Name}" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Project.Name}"/>
          <TextBlock Text="{DynamicResource Project.Description}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Project.Description}"/>
          <Separator Margin="0,16"/>
          <TextBlock Text="{Binding Editor.Id}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource AddProfile.NameLabel}" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
          <ui:TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource AddProfile.NameLabel}"/>
          <TextBlock Text="{DynamicResource Adapter.Mode}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ComboBox SelectedValue="{Binding Editor.Mode}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Adapter.Mode}">
            <ComboBoxItem Tag="dhcp" Content="{DynamicResource EditBar.Dhcp}"/>
            <ComboBoxItem Tag="static" Content="{DynamicResource EditBar.Static}"/>
          </ComboBox>
          <TextBlock Text="{DynamicResource Project.AdapterHint}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
          <ui:TextBox Text="{Binding Editor.Alias, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Project.AdapterHint}"/>
          <StackPanel IsEnabled="{Binding Editor.IsStatic}">
            <TextBlock Text="{DynamicResource EditBar.Ip}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ui:TextBox Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource EditBar.Ip}"/>
            <TextBlock Text="{DynamicResource Project.Prefix}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ui:TextBox Text="{Binding Editor.Prefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Project.Prefix}"/>
            <TextBlock Text="{DynamicResource Project.Gateway}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ui:TextBox Text="{Binding Editor.Gateway, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Project.Gateway}"/>
            <TextBlock Text="{DynamicResource Project.DnsMode}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
            <ComboBox SelectedValue="{Binding Editor.DnsMode}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Project.DnsMode}">
              <ComboBoxItem Tag="leave-unchanged" Content="{DynamicResource Project.DnsUnchanged}"/>
              <ComboBoxItem Tag="automatic" Content="{DynamicResource Project.DnsAutomatic}"/>
              <ComboBoxItem Tag="static" Content="{DynamicResource EditBar.Static}"/>
            </ComboBox>
            <StackPanel IsEnabled="{Binding Editor.IsDnsStatic}">
              <TextBlock Text="{DynamicResource EditBar.PrimaryDns}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
              <ui:TextBox Text="{Binding Editor.Dns1, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource EditBar.PrimaryDns}"/>
              <TextBlock Text="{DynamicResource AddProfile.SecondaryDnsLabel}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
              <ui:TextBox Text="{Binding Editor.Dns2, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource AddProfile.SecondaryDnsLabel}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource Device.Header}"><views:DeviceDirectoryView/></TabItem>
    </TabControl>
    <Border Grid.Row="4" Style="{StaticResource FooterBar}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
          <TextBlock Text="{Binding DeviceNotice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="{Binding BackupPath}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" AutomationProperties.Name="{DynamicResource Project.Backup}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Content="{DynamicResource Project.KeepProfile}" Command="{Binding KeepProfileCommand}" MinWidth="96" Visibility="{Binding IsProfilesSection, Converter={StaticResource BoolToVis}}"/>
          <ui:Button Content="{DynamicResource Device.Keep}" Command="{Binding KeepDeviceCommand}" MinWidth="96" Visibility="{Binding IsDevicesSection, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
          <ui:Button Content="{DynamicResource Device.Open}" Command="{Binding OpenDeviceCommand}" Appearance="Primary" MinWidth="96" Visibility="{Binding IsDevicesSection, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
