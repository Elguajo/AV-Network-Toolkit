<ui:FluentWindow x:Class="NetworkProfileManager.Views.PingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:views="clr-namespace:NetworkProfileManager.Views"
 Title="{DynamicResource Ping.Title}" Width="700" Height="780" MinWidth="480" MinHeight="440"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="{DynamicResource Ping.Title}" ShowMinimize="False"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <views:AdapterDiagnosticsPanel Margin="20,12,20,16"/>
  </ScrollViewer>
  <Border Grid.Row="2" Style="{StaticResource FooterBar}">
   <ui:Button Content="{DynamicResource Common.Close}" MinWidth="96" HorizontalAlignment="Right" Click="CloseClick" IsCancel="True"/>
  </Border>
 </Grid>
</ui:FluentWindow>
