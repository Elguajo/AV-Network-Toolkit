<UserControl x:Class="NetworkProfileManager.Views.ProjectProfilesPanel" x:Name="PanelRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:converters="clr-namespace:NetworkProfileManager.Converters">
 <UserControl.Resources><converters:ProjectProfileSummaryConverter x:Key="ProfileSummary"/></UserControl.Resources>
 <StackPanel>
  <WrapPanel Margin="0,12,0,8">
   <TextBlock Text="{DynamicResource Workspace.ProjectProfiles}" Style="{StaticResource SectionHeaderText}" Margin="0,0,16,8"/>
   <ui:Button Content="{DynamicResource Profiles.AddButton}" Icon="{ui:SymbolIcon Add20}" Click="Add_Click" Margin="0,0,0,8"/>
  </WrapPanel>
  <TextBlock Text="{DynamicResource Workspace.ProjectScopeHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <ItemsControl ItemsSource="{Binding Profiles}">
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,4">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Id}"/>
        <TextBlock Text="{Binding Converter={StaticResource ProfileSummary}}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
       </StackPanel>
       <WrapPanel Grid.Column="1" MaxWidth="260" VerticalAlignment="Center">
        <ui:Button Content="{Binding TargetLabel, ElementName=PanelRoot}" Click="Apply_Click" Tag="{Binding}" Margin="0,0,4,4" MaxWidth="200">
         <ui:Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="176"/></DataTemplate></ui:Button.ContentTemplate>
        </ui:Button>
        <ui:Button Icon="{ui:SymbolIcon Edit20}" Click="Edit_Click" Tag="{Binding}" Style="{StaticResource SubtleButton}" Padding="6"
          ToolTip="{DynamicResource Common.Edit}" AutomationProperties.Name="{DynamicResource Common.Edit}"/>
        <ui:Button Icon="{ui:SymbolIcon Delete20}" Click="Delete_Click" Tag="{Binding}" Style="{StaticResource SubtleButton}" Padding="6"
          ToolTip="{DynamicResource Common.Delete}" AutomationProperties.Name="{DynamicResource Common.Delete}"/>
       </WrapPanel>
      </Grid>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{DynamicResource Workspace.EmptyProject}" TextWrapping="Wrap" Margin="0,8">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
   </Style></TextBlock.Style>
  </TextBlock>
 </StackPanel>
</UserControl>
