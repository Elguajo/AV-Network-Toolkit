<ui:FluentWindow x:Class="NetworkProfileManager.Views.ApplicationUpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Updates.Title}" Width="620" Height="640" MinWidth="460" MinHeight="440"
    WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ui:TitleBar Title="{DynamicResource Updates.Title}" ShowMinimize="False"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,20">
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource SectionHeaderText}"/>
            <TextBlock Text="{Binding PackageKind}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <CheckBox Content="{DynamicResource Updates.AutoCheck}" IsChecked="{Binding AutomaticChecks}" IsEnabled="{Binding CanConfigure}" Margin="0,4,0,8"/>
        <CheckBox Content="{DynamicResource Updates.IncludePreview}" IsChecked="{Binding IncludePreview}" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,12"/>
        <TextBlock Text="{DynamicResource Updates.Hint}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
        <WrapPanel Margin="0,0,0,12">
          <ui:Button Content="{DynamicResource Updates.Check}" Command="{Binding CheckCommand}" Margin="0,0,8,8"/>
          <ui:Button Content="{DynamicResource Updates.Download}" Command="{Binding DownloadCommand}" Margin="0,0,8,8"/>
          <ui:Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Margin="0,0,0,8"/>
        </WrapPanel>
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,0,12" AutomationProperties.Name="{DynamicResource Updates.Progress}"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12"/>
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Updates.Details}"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource FooterBar}">
      <WrapPanel HorizontalAlignment="Right">
        <ui:Button Content="{DynamicResource Updates.Finish}" Command="{Binding FinishCommand}" Margin="0,0,8,4"/>
        <ui:Button Content="{DynamicResource Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,4"/>
        <ui:Button Content="{DynamicResource Common.Close}" Click="CloseClick" IsCancel="True" Margin="0,0,0,4"/>
      </WrapPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
