<UserControl x:Class="NetworkProfileManager.Views.AdapterDiagnosticsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <StackPanel>
  <WrapPanel Margin="0,0,0,12">
   <ui:Button Content="{DynamicResource Common.Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,12,8"/>
   <CheckBox Content="{DynamicResource Diagnostics.Hide}" ToolTip="{DynamicResource Diagnostics.FilterScope}"
    IsChecked="{Binding HideHyperVUplinks}" IsEnabled="{Binding CanSelect}" Margin="0,0,0,8"/>
  </WrapPanel>
  <TextBlock Text="{DynamicResource Diagnostics.Adapter}" Style="{StaticResource FieldLabel}"/>
  <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Display"
   AutomationProperties.Name="{DynamicResource Diagnostics.Adapter}" ToolTip="{Binding SelectedAdapter.Display}"
   IsEnabled="{Binding CanSelect}" HorizontalContentAlignment="Stretch"/>
  <Expander Header="{DynamicResource Diagnostics.FactsHeader}" Margin="0,12,0,12">
   <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Expander>
  <TextBlock Text="{DynamicResource Diagnostics.Source}" Style="{StaticResource FieldLabel}"/>
  <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" IsEnabled="{Binding CanSelect}"
   AutomationProperties.Name="{DynamicResource Diagnostics.Source}"/>
  <TextBlock Text="{DynamicResource Diagnostics.Target}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
  <ui:TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" MaxLength="253"
   AutomationProperties.Name="{DynamicResource Diagnostics.Target}"/>
  <TextBlock Text="{DynamicResource Diagnostics.DnsNotice}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,12"/>
  <StackPanel Orientation="Horizontal">
   <ui:Button Content="{DynamicResource EditBar.PingButton}" Command="{Binding PingCommand}" MinWidth="96" Margin="0,0,8,0"/>
   <ui:Button Content="{DynamicResource Diagnostics.Stop}" Command="{Binding StopCommand}" MinWidth="96"/>
  </StackPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite"/>
  <ItemsControl ItemsSource="{Binding Results}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
     <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{DynamicResource Diagnostics.EgressNotice}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
