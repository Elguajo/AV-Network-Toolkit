<UserControl x:Class="NetworkProfileManager.Views.DeviceDirectoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid Margin="0,12,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="DeviceLeftViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="360" Height="{Binding ActualHeight, ElementName=DeviceLeftViewport}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{DynamicResource Device.Search}" Style="{StaticResource FieldLabel}"/>
        <ui:TextBox Text="{Binding DeviceSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Search}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,12,0,8">
        <TextBlock Text="{DynamicResource Device.GroupBy}" Style="{StaticResource FieldLabel}"/>
        <ComboBox SelectedValue="{Binding DeviceGroupBy}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Device.GroupBy}">
          <ComboBoxItem Tag="type" Content="{DynamicResource Device.Type}"/>
          <ComboBoxItem Tag="profile" Content="{DynamicResource Device.Profile}"/>
        </ComboBox>
      </StackPanel>
      <ListBox Grid.Row="2" ItemsSource="{Binding DeviceView}" SelectedItem="{Binding SelectedDeviceEntry}" IsSynchronizedWithCurrentItem="False"
               ItemContainerStyle="{StaticResource NavigationListItem}" Background="Transparent" BorderThickness="0" Padding="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="{DynamicResource Device.Header}">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name.Name}" ToolTip="{Binding Name.Id}" TextWrapping="Wrap" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,4"/></DataTemplate></GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel ToolTip="{Binding Device.Name}">
              <TextBlock Text="{Binding Device.Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Device.Ip}" Style="{StaticResource CaptionText}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding NoDeviceMatches, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{DynamicResource Device.Empty}" TextWrapping="Wrap" Style="{StaticResource CaptionText}"/>
      </Border>
      <WrapPanel Grid.Row="3" Margin="0,8,0,0">
        <ui:Button Content="{DynamicResource Device.New}" Icon="{ui:SymbolIcon Add20}" Command="{Binding NewDeviceCommand}" Margin="0,0,8,8"/>
        <ui:Button Content="{DynamicResource Project.Delete}" Style="{StaticResource SubtleButton}" Padding="10,6" Command="{Binding DeleteDeviceCommand}" Margin="0,0,0,8"/>
      </WrapPanel>
    </Grid>
    </ScrollViewer>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{DynamicResource Device.EditorHint}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
        <TextBlock Text="{DynamicResource Device.Name}" Style="{StaticResource FieldLabel}"/>
        <ui:TextBox Text="{Binding DeviceEditor.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Name}"/>
        <TextBlock Text="{DynamicResource Device.Url}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <ui:TextBox Text="{Binding DeviceEditor.WebUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Url}"/>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Device.Destination}" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="{Binding DeviceDestination}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.Name="{DynamicResource Device.Destination}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{DynamicResource Device.Ip}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <ui:TextBox Text="{Binding DeviceEditor.Ip, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Ip}"/>
        <TextBlock Text="{DynamicResource Device.Type}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <ui:TextBox Text="{Binding DeviceEditor.Type, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Type}"/>
        <TextBlock Text="{DynamicResource Device.Manufacturer}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <ui:TextBox Text="{Binding DeviceEditor.Manufacturer, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Manufacturer}"/>
        <TextBlock Text="{DynamicResource Device.Profile}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <ComboBox ItemsSource="{Binding DeviceProfiles}" SelectedValuePath="Id" SelectedValue="{Binding DeviceEditor.ProfileId}"
                  AutomationProperties.Name="{DynamicResource Device.Profile}">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Id}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding DeviceProfileStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <ui:Button Content="{DynamicResource Device.Unlink}" Command="{Binding UnlinkDeviceCommand}" Style="{StaticResource SubtleButton}" Padding="10,6" HorizontalAlignment="Left" Margin="0,4,0,0"/>
        <ui:Button Content="{DynamicResource Apply.Title}" Command="{Binding ApplyAndOpenCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Password.Title}" Style="{StaticResource FieldLabel}"/>
            <CheckBox Content="{DynamicResource Password.OptIn}" IsChecked="{Binding DeviceEditor.SavePassword}"
                      IsEnabled="{Binding DeviceEditor.CanChoosePasswordStorage}" Margin="0,0,0,8"/>
            <PasswordBox x:Name="DevicePasswordInput" PasswordChanged="Password_Changed"
                         IsEnabled="{Binding DeviceEditor.SavePassword}" AutomationProperties.Name="{DynamicResource Password.Title}"
                         Height="40" FontSize="14" Padding="12,6"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
              <PasswordBox.Template>
                <ControlTemplate TargetType="PasswordBox">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </PasswordBox.Template>
            </PasswordBox>
            <TextBlock x:Name="DeviceRevealedPassword" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            <WrapPanel Margin="0,8,0,0">
              <ui:Button Content="{Binding DeviceEditor.RevealCaption}" Command="{Binding RevealPasswordCommand}" Margin="0,0,8,8"/>
              <ui:Button Content="{DynamicResource Password.Copy}" Command="{Binding CopyPasswordCommand}" Margin="0,0,8,8"/>
              <ui:Button Content="{DynamicResource Password.Remove}" Command="{Binding RemovePasswordCommand}" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="{DynamicResource Password.Warning}" TextWrapping="Wrap" Style="{StaticResource CaptionText}"/>
            <TextBlock Text="{DynamicResource Password.ClipboardHint}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{DynamicResource Device.Notes}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <ui:TextBox Text="{Binding DeviceEditor.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="{DynamicResource Device.Notes}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
