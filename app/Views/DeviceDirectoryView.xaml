<UserControl x:Class="NetworkProfileManager.Views.DeviceDirectoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="0,12,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="0.35*" MinWidth="140" MaxWidth="220"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
  <ScrollViewer x:Name="DeviceLeftViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid MinHeight="300" Height="{Binding ActualHeight, ElementName=DeviceLeftViewport}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="{DynamicResource Device.Search}" Style="{StaticResource FieldLabel}"/>
     <ui:TextBox Text="{Binding DeviceSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Device.Search}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,12,0,8">
     <TextBlock Text="{DynamicResource Device.GroupBy}" Style="{StaticResource FieldLabel}"/>
     <ComboBox SelectedValue="{Binding DeviceGroupBy}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Device.GroupBy}">
      <ComboBoxItem Tag="type" Content="{DynamicResource Device.Type}"/>
      <ComboBoxItem Tag="profile" Content="{DynamicResource Device.Profile}"/>
     </ComboBox>
    </StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding DeviceView}" SelectedItem="{Binding SelectedDeviceEntry}" IsSynchronizedWithCurrentItem="False"
     ItemContainerStyle="{StaticResource NavigationListItem}" Background="Transparent" BorderThickness="0" Padding="0"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Device.Header}">
     <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
      <TextBlock Text="{Binding Name.Name}" ToolTip="{Binding Name.Id}" TextWrapping="Wrap" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,4"/>
     </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Device.Name}">
      <TextBlock Text="{Binding Device.Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionText}"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding NoDeviceMatches, Converter={StaticResource BoolToVis}}">
     <TextBlock Text="{Binding DeviceEmptyText}" TextWrapping="Wrap" Style="{StaticResource CaptionText}"/>
    </Border>
    <ui:Button Grid.Row="3" x:Name="NewDeviceButton" Content="{DynamicResource Device.New}" Icon="{ui:SymbolIcon Add20}" Click="New_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   </Grid>
  </ScrollViewer>
  <ScrollViewer x:Name="DeviceDetailsViewport" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid Margin="0,0,12,0">
    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasNoSelectedDevice, Converter={StaticResource BoolToVis}}">
     <TextBlock Text="{DynamicResource Device.SelectHint}" TextWrapping="Wrap"/>
    </Border>
    <StackPanel Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVis}}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
       <TextBlock Text="{Binding SelectedDevice.Name}" Style="{StaticResource PageTitleText}" TextWrapping="Wrap"/>
       <TextBlock Text="{DynamicResource Device.Interface}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
      </StackPanel>
      <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon MoreHorizontal20}" Click="More_Click" Style="{StaticResource SubtleButton}" VerticalAlignment="Top"
       ToolTip="{DynamicResource Device.More}" AutomationProperties.Name="{DynamicResource Device.More}">
       <ui:Button.ContextMenu><ContextMenu><MenuItem Header="{DynamicResource Project.Delete}" Command="{Binding DeleteDeviceCommand}"/></ContextMenu></ui:Button.ContextMenu>
      </ui:Button>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
       <TextBlock Text="{DynamicResource Device.Url}" Style="{StaticResource FieldLabel}"/>
       <TextBlock Text="{Binding DeviceDestination}" TextWrapping="Wrap" TextTrimming="None" AutomationProperties.Name="{DynamicResource Device.Destination}"/>
       <WrapPanel Margin="0,16,0,0">
        <ui:Button Content="{DynamicResource Device.Open}" Command="{Binding OpenDeviceCommand}" Appearance="Primary" Margin="0,0,8,8"/>
        <ui:Button x:Name="EditDeviceButton" Content="{DynamicResource Device.EditTitle}" Click="Edit_Click" Margin="0,0,0,8"/>
       </WrapPanel>
       <TextBlock Text="{DynamicResource Device.OpenHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
       <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,16"/>
       <TextBlock Text="{DynamicResource Device.Profile}" Style="{StaticResource FieldLabel}"/>
       <TextBlock Text="{Binding DeviceProfileStatus}" TextWrapping="Wrap"/>
       <ui:Button Content="{DynamicResource Apply.Title}" Command="{Binding ApplyAndOpenCommand}" Visibility="{Binding HasLinkedDeviceProfile, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       <TextBlock Text="{DynamicResource Password.Title}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
       <TextBlock Text="{Binding DevicePasswordStatus}" TextWrapping="Wrap"/>
       <StackPanel Visibility="{Binding DeviceEditor.SavePassword, Converter={StaticResource BoolToVis}}">
        <TextBlock x:Name="DeviceRevealedPassword" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <WrapPanel Margin="0,8,0,0">
         <ui:Button Content="{Binding DeviceEditor.RevealCaption}" Command="{Binding RevealPasswordCommand}" Margin="0,0,8,8"/>
         <ui:Button Content="{DynamicResource Password.Copy}" Command="{Binding CopyPasswordCommand}" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock Text="{DynamicResource Password.Warning}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource Password.ClipboardHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel>
       <TextBlock Text="{DynamicResource Device.EditHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
      </StackPanel>
     </Border>
     <Expander Header="{DynamicResource Device.DetailsOptional}" Margin="0,12,0,0" Visibility="{Binding HasDeviceDetails, Converter={StaticResource BoolToVis}}">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="{DynamicResource Device.Type}" Style="{StaticResource FieldLabel}"/>
       <TextBlock Text="{Binding SelectedDevice.Type}" TextWrapping="Wrap"/>
       <TextBlock Text="{DynamicResource Device.Manufacturer}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
       <TextBlock Text="{Binding SelectedDevice.Manufacturer}" TextWrapping="Wrap"/>
       <TextBlock Text="{DynamicResource Device.Ip}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
       <TextBlock Text="{Binding SelectedDevice.Ip}" TextWrapping="Wrap"/>
       <TextBlock Text="{DynamicResource Device.Notes}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
       <TextBlock Text="{Binding SelectedDevice.Notes}" TextWrapping="Wrap"/>
      </StackPanel></Border>
     </Expander>
    </StackPanel>
   </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>
