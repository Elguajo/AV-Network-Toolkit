<ui:FluentWindow x:Class="NetworkProfileManager.Views.ProjectDiscardDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="{DynamicResource Project.Title}" Width="460" Height="260" MinWidth="380" MinHeight="240"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
 WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="{DynamicResource Project.Title}" ShowMinimize="False" ShowMaximize="False"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,12,20,16">
   <StackPanel>
    <TextBlock Text="{DynamicResource Project.Discard}" Style="{StaticResource SectionHeaderText}" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource Project.DiscardHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Style="{StaticResource FooterBar}">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <ui:Button x:Name="DiscardButton" Content="{DynamicResource Project.DiscardAction}" AutomationProperties.Name="{DynamicResource Project.DiscardAction}"
     MinWidth="96" Margin="0,0,8,0" Click="Discard_Click"/>
    <ui:Button x:Name="CancelButton" Content="{DynamicResource Common.Cancel}" AutomationProperties.Name="{DynamicResource Common.Cancel}"
     MinWidth="96" Appearance="Primary" IsDefault="True" IsCancel="True" Click="Cancel_Click"/>
   </StackPanel>
  </Border>
 </Grid>
</ui:FluentWindow>
