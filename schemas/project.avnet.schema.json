{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/project.avnet.schema.json",
  "title": "Draft AV Network Manager project schema (not yet implemented)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "profiles",
    "devices"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    }
  },
  "$defs": {
    "ipv4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "prefixLength",
        "gateway",
        "dns"
      ],
      "properties": {
        "address": {
          "type": "string",
          "format": "ipv4"
        },
        "prefixLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "gateway": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "ipv4"
            }
          ]
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "servers"
          ],
          "properties": {
            "mode": {
              "enum": [
                "automatic",
                "static"
              ]
            },
            "servers": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "ipv4"
              },
              "maxItems": 2
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "static"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "properties": {
                  "servers": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "automatic"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "properties": {
                  "servers": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "static",
            "dhcp",
            "link-local"
          ]
        },
        "adapterHint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferredAlias": {
              "type": "string"
            }
          }
        },
        "ipv4": {
          "$ref": "#/$defs/ipv4"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "static"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "ipv4"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "dhcp",
                  "link-local"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "ipv4"
              ]
            }
          }
        }
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "webUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "ip": {
          "type": "string",
          "format": "ipv4"
        },
        "webUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "profileId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
